Attribute VB_Name = "modSchoolData"
Option Explicit
' =====================================================================================
'  modSchoolData : 초·중·고 학교 마스터 데이터 (정식명 / 교육지원청 / 설립구분)
'   - 우선순위: 현재 통합 문서에 '초등학교현황'·'중학교현황'·'고등학교현황' 시트가 있으면 그 시트 데이터,
'               없으면 아래 내장 데이터 사용 (자료 기준일 2026-09-26, 나이스 시각화 자료)
'   - 지원청 코드: 남부·북부·동래·서부·해운대 → "○○교육지원청", 본청(고등학교) → "본청"
'   - 다른 모듈은 SD_* 함수만 호출한다. 데이터 갱신은 Embed_초/중/고 의 L "..." 줄만 고치면 된다.
' =====================================================================================
Public Const SD_SHEET_초 As String = "초등학교현황"
Public Const SD_SHEET_중 As String = "중학교현황"
Public Const SD_SHEET_고 As String = "고등학교현황"
Public Const SD_DATA_DATE As String = "2026-09-26"

Private mAll As Object              ' 정식명 → Array(level, office, found)
Private mLevel(1 To 3) As Object    ' 급별 정식명 → office
Private mSource(1 To 3) As String   ' "시트" / "내장"
Private mCur As Object              ' L 호출 시 채워지는 임시 사전
Private mLoaded As Boolean

' ---------------------------------------------------------------- 공개 API
Public Sub SD_Load(Optional ByVal force As Boolean = False)
    Dim lv As Long
    If mLoaded And Not force Then Exit Sub
    Set mAll = CreateObject("Scripting.Dictionary")
    For lv = 1 To 3
        Set mLevel(lv) = CreateObject("Scripting.Dictionary")
        If Not SD_LoadFromSheet(lv) Then SD_LoadEmbedded lv
    Next lv
    mLoaded = True
End Sub

' 내장 데이터만(시트 무시) - 현황시트 생성용
Public Function SD_EmbeddedRows(ByVal lv As Long) As Variant
    Dim k As Variant, arr() As Variant, i As Long, parts() As String
    Set mCur = CreateObject("Scripting.Dictionary")
    Select Case lv
        Case 1: Embed_초
        Case 2: Embed_중
        Case 3: Embed_고
    End Select
    ReDim arr(1 To mCur.Count, 1 To 3)
    For Each k In mCur.keys
        i = i + 1
        parts = Split(mCur(k), "|")
        arr(i, 1) = CStr(k): arr(i, 2) = SD_OfficeName(parts(0)): arr(i, 3) = parts(1)
    Next k
    SD_EmbeddedRows = arr
End Function

Public Function SD_Exists(ByVal fullName As String) As Boolean
    SD_Load
    SD_Exists = mAll.Exists(fullName)
End Function

' 정식명 → 급(1~3), 지원청, 설립구분
Public Function SD_Lookup(ByVal fullName As String, ByRef lv As Long, ByRef office As String, ByRef found As String) As Boolean
    Dim v As Variant
    SD_Load
    If Not mAll.Exists(fullName) Then Exit Function
    v = mAll(fullName)
    lv = v(0): office = v(1): found = v(2)
    SD_Lookup = True
End Function

Public Function SD_Names(ByVal lv As Long) As Object
    SD_Load
    Set SD_Names = mLevel(lv)
End Function

Public Function SD_Source(ByVal lv As Long) As String
    SD_Load
    SD_Source = mSource(lv)
End Function

Public Function SD_Count(ByVal lv As Long) As Long
    SD_Load
    SD_Count = mLevel(lv).Count
End Function

Public Function SD_SheetName(ByVal lv As Long) As String
    Select Case lv
        Case 1: SD_SheetName = SD_SHEET_초
        Case 2: SD_SheetName = SD_SHEET_중
        Case 3: SD_SheetName = SD_SHEET_고
    End Select
End Function

Public Function SD_LevelName(ByVal lv As Long) As String
    Select Case lv
        Case 1: SD_LevelName = "초등학교"
        Case 2: SD_LevelName = "중학교"
        Case 3: SD_LevelName = "고등학교"
    End Select
End Function

Public Function SD_OfficeName(ByVal code As String) As String
    code = Trim$(code)
    If code = "" Or code = "본청" Then
        SD_OfficeName = "본청"
    ElseIf InStr(code, "교육") > 0 Then
        SD_OfficeName = code
    Else
        SD_OfficeName = code & "교육지원청"
    End If
End Function

' 지원청 표기인지(오른쪽 열 덮어쓰기 판단용)
Public Function SD_IsOfficeText(ByVal s As String) As Boolean
    s = Trim$(s)
    SD_IsOfficeText = (s = "본청" Or (InStr(s, "교육지원청") > 0 And Len(s) <= 14))
End Function

' ---------------------------------------------------------------- 내부: 적재
Private Sub SD_Put(ByVal lv As Long, ByVal nm As String, ByVal office As String, ByVal found As String)
    nm = Replace(Trim$(nm), " ", "")
    If nm = "" Then Exit Sub
    If Not mAll.Exists(nm) Then mAll.Add nm, Array(lv, office, found)
    If Not mLevel(lv).Exists(nm) Then mLevel(lv).Add nm, office
End Sub

Private Sub SD_LoadEmbedded(ByVal lv As Long)
    Dim k As Variant, parts() As String
    Set mCur = CreateObject("Scripting.Dictionary")
    Select Case lv
        Case 1: Embed_초
        Case 2: Embed_중
        Case 3: Embed_고
    End Select
    For Each k In mCur.keys
        parts = Split(mCur(k), "|")
        SD_Put lv, CStr(k), SD_OfficeName(parts(0)), parts(1)
    Next k
    mSource(lv) = "내장"
End Sub

' 현황시트가 있으면 시트에서 읽기 (머리글 '학교명' 을 찾아 그 아래를 읽음)
Private Function SD_LoadFromSheet(ByVal lv As Long) As Boolean
    Dim ws As Worksheet, hdr As Range, cName As Long, cOff As Long, cFnd As Long, r As Long, lastR As Long, n As Long
    Dim nm As String, off As String, fnd As String
    If ActiveWorkbook Is Nothing Then Exit Function
    On Error Resume Next
    Set ws = ActiveWorkbook.Worksheets(SD_SheetName(lv))
    On Error GoTo 0
    If ws Is Nothing Then Exit Function
    Set hdr = ws.Range("A1:H8").Find("학교명", LookIn:=xlValues, LookAt:=xlWhole)
    If hdr Is Nothing Then Exit Function
    cName = hdr.Column
    cOff = SD_FindCol(ws, hdr.row, "교육지원청", "지원청")
    cFnd = SD_FindCol(ws, hdr.row, "설립구분", "설립")
    lastR = ws.Cells(ws.rows.Count, cName).End(xlUp).row
    For r = hdr.row + 1 To lastR
        nm = Trim$(CStr(ws.Cells(r, cName).value))
        If nm <> "" Then
            off = "": fnd = ""
            If cOff > 0 Then off = SD_OfficeName(CStr(ws.Cells(r, cOff).value))
            If cFnd > 0 Then fnd = Trim$(CStr(ws.Cells(r, cFnd).value))
            SD_Put lv, nm, off, fnd
            n = n + 1
        End If
    Next r
    If n = 0 Then Exit Function
    mSource(lv) = "시트"
    SD_LoadFromSheet = True
End Function

Private Function SD_FindCol(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal t1 As String, ByVal t2 As String) As Long
    Dim c As Long, v As String
    For c = 1 To 12
        v = Trim$(CStr(ws.Cells(hdrRow, c).value))
        If v = t1 Or v = t2 Then SD_FindCol = c: Exit Function
    Next c
End Function

Private Sub L(ByVal s As String)
    Dim p As Long
    p = InStr(s, "|")
    If p = 0 Then Exit Sub
    If Not mCur.Exists(Left$(s, p - 1)) Then mCur.Add Left$(s, p - 1), Mid$(s, p + 1)
End Sub

